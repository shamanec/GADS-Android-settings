<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:allowBackup="true"
        android:label="GADS Settings"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        tools:targetApi="n">

        <service
            android:name=".GADSKeyboardIME"
            android:label="GADS Remote Keyboard"
            android:exported="true"
            android:theme="@style/AppTheme"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/keyboard_ime" />
        </service>

        <receiver android:name=".ClipboardReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.gads.settings.CLIPBOARD_GET"/>
                <action android:name="com.gads.settings.CLIPBOARD_SET"/>
            </intent-filter>
        </receiver>
    </application>

</manifest>